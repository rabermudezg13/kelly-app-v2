{
  "name": "kelly-front-desk-frontend",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3025",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "predev": "node scripts/prepare-capture.mjs && node scripts/prepare-dashtracker.mjs",
    "prebuild": "node scripts/prepare-capture.mjs && node scripts/prepare-dashtracker.mjs",
    "test:capture": "node --experimental-strip-types --test src/smart-capture/*.test.mjs",
    "test:tracker": "node --test tests/dashtracker.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "pdf-lib": "1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tesseract.js": "7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
